<!doctype html><html lang="en"><head>
    <meta charset="UTF-8">
    <title>Title</title>
    <style>
      @font-face {
        font-family: 'Material Symbols Outlined';
        font-style: normal;
        font-weight: 400;
        font-display: block;
        /* There is a variable version, but it's 2.1MB so we use the static version. */
        src: url('https://cdn.fynbos.app/fonts/material-symbols-outlined-static.woff2')
          format('woff2');
      }
      /* cyrillic-ext */
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('https://cdn.fynbos.app/fonts/inter/v12/cyrillic-ext.woff2')
          format('woff2');
        unicode-range: U+0460-052F, U+1C80-1C88, U+20B4, U+2DE0-2DFF,
          U+A640-A69F, U+FE2E-FE2F;
      }
      /* cyrillic */
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('https://cdn.fynbos.app/fonts/inter/v12/cyrillic.woff2')
          format('woff2');
        unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;
      }
      /* greek-ext */
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('https://cdn.fynbos.app/fonts/inter/v12/greek-ext.woff2')
          format('woff2');
        unicode-range: U+1F00-1FFF;
      }
      /* greek */
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('https://cdn.fynbos.app/fonts/inter/v12/greek.woff2')
          format('woff2');
        unicode-range: U+0370-03FF;
      }
      /* vietnamese */
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('https://cdn.fynbos.app/fonts/inter/v12/vietnamese.woff2')
          format('woff2');
        unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169,
          U+01A0-01A1, U+01AF-01B0, U+1EA0-1EF9, U+20AB;
      }
      /* latin-ext */
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('https://cdn.fynbos.app/fonts/inter/v12/latin-ext.woff2')
          format('woff2');
        unicode-range: U+0100-024F, U+0259, U+1E00-1EFF, U+2020, U+20A0-20AB,
          U+20AD-20CF, U+2113, U+2C60-2C7F, U+A720-A7FF;
      }
      /* latin */
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('https://cdn.fynbos.app/fonts/inter/v12/latin.woff2')
          format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6,
          U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193,
          U+2212, U+2215, U+FEFF, U+FFFD;
      }
      /* cyrillic-ext */
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 500;
        font-display: swap;
        src: url('https://cdn.fynbos.app/fonts/inter/v12/cyrillic-ext.woff2')
          format('woff2');
        unicode-range: U+0460-052F, U+1C80-1C88, U+20B4, U+2DE0-2DFF,
          U+A640-A69F, U+FE2E-FE2F;
      }
      /* cyrillic */
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 500;
        font-display: swap;
        src: url('https://cdn.fynbos.app/fonts/inter/v12/cyrillic.woff2')
          format('woff2');
        unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;
      }
      /* greek-ext */
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 500;
        font-display: swap;
        src: url('https://cdn.fynbos.app/fonts/inter/v12/greek-ext.woff2')
          format('woff2');
        unicode-range: U+1F00-1FFF;
      }
      /* greek */
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 500;
        font-display: swap;
        src: url('https://cdn.fynbos.app/fonts/inter/v12/greek.woff2')
          format('woff2');
        unicode-range: U+0370-03FF;
      }
      /* vietnamese */
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 500;
        font-display: swap;
        src: url('https://cdn.fynbos.app/fonts/inter/v12/vietnamese.woff2')
          format('woff2');
        unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169,
          U+01A0-01A1, U+01AF-01B0, U+1EA0-1EF9, U+20AB;
      }
      /* latin-ext */
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 500;
        font-display: swap;
        src: url('https://cdn.fynbos.app/fonts/inter/v12/latin-ext.woff2')
          format('woff2');
        unicode-range: U+0100-024F, U+0259, U+1E00-1EFF, U+2020, U+20A0-20AB,
          U+20AD-20CF, U+2113, U+2C60-2C7F, U+A720-A7FF;
      }
      /* latin */
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 500;
        font-display: swap;
        src: url('https://cdn.fynbos.app/fonts/inter/v12/latin.woff2')
          format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6,
          U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193,
          U+2212, U+2215, U+FEFF, U+FFFD;
      }
      /* devanagari */
      @font-face {
        font-family: 'Poppins';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('https://cdn.fynbos.app/fonts/poppins/v20/400/devanagari.woff2')
          format('woff2');
        unicode-range: U+0900-097F, U+1CD0-1CF6, U+1CF8-1CF9, U+200C-200D,
          U+20A8, U+20B9, U+25CC, U+A830-A839, U+A8E0-A8FB;
      }
      /* latin-ext */
      @font-face {
        font-family: 'Poppins';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('https://cdn.fynbos.app/fonts/poppins/v20/400/latin-ext.woff2')
          format('woff2');
        unicode-range: U+0100-024F, U+0259, U+1E00-1EFF, U+2020, U+20A0-20AB,
          U+20AD-20CF, U+2113, U+2C60-2C7F, U+A720-A7FF;
      }
      /* latin */
      @font-face {
        font-family: 'Poppins';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('https://cdn.fynbos.app/fonts/poppins/v20/400/latin.woff2')
          format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6,
          U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193,
          U+2212, U+2215, U+FEFF, U+FFFD;
      }
      /* devanagari */
      @font-face {
        font-family: 'Poppins';
        font-style: normal;
        font-weight: 500;
        font-display: swap;
        src: url('https://cdn.fynbos.app/fonts/poppins/v20/500/devanagari.woff2')
          format('woff2');
        unicode-range: U+0900-097F, U+1CD0-1CF6, U+1CF8-1CF9, U+200C-200D,
          U+20A8, U+20B9, U+25CC, U+A830-A839, U+A8E0-A8FB;
      }
      /* latin-ext */
      @font-face {
        font-family: 'Poppins';
        font-style: normal;
        font-weight: 500;
        font-display: swap;
        src: url('https://cdn.fynbos.app/fonts/poppins/v20/500/latin-ext.woff2')
          format('woff2');
        unicode-range: U+0100-024F, U+0259, U+1E00-1EFF, U+2020, U+20A0-20AB,
          U+20AD-20CF, U+2113, U+2C60-2C7F, U+A720-A7FF;
      }
      /* latin */
      @font-face {
        font-family: 'Poppins';
        font-style: normal;
        font-weight: 500;
        font-display: swap;
        src: url('https://cdn.fynbos.app/fonts/poppins/v20/500/latin.woff2')
          format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6,
          U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193,
          U+2212, U+2215, U+FEFF, U+FFFD;
      }
      html {
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
      h1 {
        font-family: 'Poppins', sans-serif;
        font-weight: 500;
        margin: 0;
        font-style: normal;
        font-size: 24px;
        line-height: 32px;
        color: #0f172a;
      }
      h2 {
        font-family: 'Poppins', sans-serif;
        font-weight: 500;
        margin: 0;
        font-style: normal;
        font-size: 16px;
        line-height: 24px;
        color: #0f172a;
      }
      p {
        font-family: 'Inter', sans-serif;
        font-weight: 400;
        margin: 0;
        font-style: normal;
        font-size: 16px;
        line-height: 24px;
        color: #334155;
      }
      a {
        color: #3b82f6;
        text-decoration: none;
      }
      .anchorButton {
        display: flex;
        height: 50px;
        width: 100%;
        margin-top: 32px;
        border-radius: 9999px;
        font-family: 'Poppins', sans-serif;
        font-weight: 500;
        font-size: 16px;
        line-height: 24px;
        text-align: center;
        background-color: #3b82f6;
        color: white;
      }

      .anchorButton:hover {
        background-color: #60a5fa;
      }
    </style>
  </head>
  <body>
    <table style="
        font-size: 17px;
        line-height: 24px;
        color: #0f172a;
        background: #f8fafc;
        width: 100%;
        border-collapse: collapse;
        border: 0;
      ">
      <tbody>
        <tr>
          <td style="vertical-align: top; padding: 24px 16px">
            <center>
              <table style="
                  border: 0;
                  border-collapse: collapse;
                  text-align: left;
                  margin: 0 auto 16px;
                ">
                <tbody>
                  <tr>
                    <td style="width: 442px; vertical-align: top; padding: 0">
                      <div style="max-width: 442px; margin: 0 auto">
                        <a href="https://fynbos.app" target="_blank"><img src="https://cdn.fynbos.app/logos/32px.png" height="32" class="CToWUd" data-bit="iit"></a>
                      </div>
                    </td>
                  </tr>
                </tbody>
              </table>
            </center>
            <center>
              <table style="
                  border: 0;
                  border-collapse: collapse;
                  text-align: left;
                  background: white;
                  border-radius: 20px;
                  margin: 0 auto 24px;
                ">
                <tbody>
                  <tr>
                    <td style="
                        width: 442px;
                        vertical-align: top;
                        padding: 16px 16px 24px 16px;
                      ">
                      <div style="max-width: 442px; margin: 0 auto">
                        <article>
  <h1>Invalid account recovery attempt</h1>
  <p style="margin: 24px auto 0">
    You (or someone else) entered this email address when trying to recover
    access to a Fynbos account.
  </p>
  <p style="margin: 24px auto 0">
    However, this email address is not on our database of registered users and
    therefore the attempt has failed.
  </p>
  <p style="margin: 16px auto 0">
    If this was you, please check if you signed up using a different email
    address.
  </p>
  <p style="margin: 24px auto 0">
    If this was not you, you can safely ignore this email.
  </p>
</article>
                      </div>
                    </td>
                  </tr>
                </tbody>
              </table>
            </center>
            <center>
              <table style="
                  border: 0;
                  border-collapse: collapse;
                  text-align: left;
                  background: white;
                  border-radius: 20px;
                  margin: 0 auto 24px;
                ">
                <tbody>
                  <tr>
                    <td style="width: 442px; vertical-align: top; padding: 16px">
                      <div style="max-width: 442px; margin: 0 auto">
                        <h2 style="margin: 0 auto 16px">Support</h2>
                        <p style="
                            margin: 0 auto 12px;
                            font-size: 14px;
                            line-height: 20px;
                          ">
                          Our telephone support lines are open Monday to Friday
                          between 9am and 5pm EST.
                        </p>
                        <p style="font-size: 14px; line-height: 20px">
                          support@fynbos.app
                        </p>
                      </div>
                    </td>
                  </tr>
                </tbody>
              </table>
            </center>
            <center>
              <table style="
                  border: 0;
                  border-collapse: collapse;
                  text-align: left;
                  margin: 0 auto 24px;
                ">
                <tbody>
                  <tr>
                    <td style="width: 442px; vertical-align: top; padding: 0 16px">
                      <div style="max-width: 442px; margin: 0 auto">
                        <p style="
                            margin: 0 auto 8px;
                            font-size: 12px;
                            line-height: 16px;
                          ">
                          You received this e-mail because you signed up for an
                          account at fynbos.app.
                        </p>
                        <p style="
                            margin: 0 auto 32px;
                            font-size: 12px;
                            line-height: 16px;
                          ">
                          We respect your right to privacy. For more
                          information, please see our Privacy Policy and Terms
                          &amp; Conditions.
                        </p>
                        <p style="
                            font-size: 12px;
                            line-height: 16px;
                            font-weight: 500;
                          ">
                          <span style="margin-right: 12px">
                            &copy;&nbsp;Fynbos
                          </span>
                          <a href="https://fynbos.app/legal" target="_blank">
                            Privacy &amp; Terms
                          </a>
                        </p>
                      </div>
                    </td>
                  </tr>
                </tbody>
              </table>
            </center>
          </td>
        </tr>
      </tbody>
    </table>


</body></html>