{
  "name": "protea",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "remix dev",
    "build": "build:css && remix build",
    "postinstall": "remix setup node",
    "start": "remix-serve build",
    "lint": "eslint ./app",
    "format": "prettier --write .",
    "generate": "graphql-codegen --config codegen.yml",
    "generate:watch": "graphql-codegen --watch --config codegen.yml",
    "build:css": "tailwindcss -m -i ./styles/app.css -o app/styles/app.css",
    "dev:css": "tailwindcss -w -i ./styles/app.css -o app/styles/app.css"
  },
  "dependencies": {
    "@apollo/client": "^3.4.17",
    "@headlessui/react": "^1.4.1",
    "@mapbox/rehype-prism": "^0.7.0",
    "@ory/kratos-client": "0.0.0-next.059ed9c9cacb",
    "@remix-run/react": "^1.1.3",
    "@remix-run/serve": "^1.1.3",
    "graphql": "^16.0.1",
    "luxon": "^2.0.2",
    "react": "^17.0.2",
    "react-dom": "17.0.2",
    "react-hook-form": "^7.17.5",
    "rehype-slug": "^4.0.1",
    "remix": "^1.1.3"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "2.2.2",
    "@graphql-codegen/typescript": "2.3.1",
    "@graphql-codegen/typescript-operations": "2.2.0",
    "@graphql-codegen/typescript-react-apollo": "^3.2.1",
    "@remix-run/dev": "^1.1.3",
    "@remix-run/eslint-config": "^1.1.3",
    "@tailwindcss/forms": "^0.4.0",
    "@tailwindcss/typography": "^0.5.1",
    "@types/luxon": "^2",
    "@types/node": "^16.9.0",
    "@types/react": "17.0.24",
    "@types/react-dom": "^17.0.11",
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "autoprefixer": "latest",
    "concurrently": "^7.0.0",
    "eslint": "^8.8.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-react": "latest",
    "postcss": "latest",
    "prettier": "^2.3.2",
    "prettier-plugin-tailwindcss": "^0.1.3",
    "tailwindcss": "latest",
    "tailwindcss-selection-variant": "^0.1.0",
    "typescript": "4.4.2"
  },
  "packageManager": "yarn@3.1.1",
  "engines": {
    "node": ">=14"
  },
  "sideEffects": false
}