{
  "name": "protea",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--inspect' remix dev",
    "build": "yarn typecheck && yarn build:css && remix build",
    "start": "remix-serve build",
    "lint": "eslint --fix --cache --cache-location ./node_modules/.cache/eslint .",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "routes-gen": "routes-gen -d @routes-gen/remix",
    "build:css": "tailwindcss -m -i ./styles/app.css -o app/styles/app.css",
    "dev:css": "tailwindcss -w -i ./styles/app.css -o app/styles/app.css",
    "precommit": "yarn format && yarn lint && yarn routes-gen && yarn build && yarn build-storybook",
    "storybook": "run-p \"storybook:*\"",
    "storybook:dev": "storybook dev -p 6006 --no-open",
    "storybook:css": "tailwindcss -w -i ./styles/app.css -o .storybook/app.css",
    "build-storybook": "tailwindcss -m -i ./styles/app.css -o .storybook/app.css && storybook build",
    "test:integration": "playwright test",
    "test:unit": "vitest",
    "report": "playwright show-report",
    "chromatic": "chromatic --exit-zero-on-changes"
  },
  "dependencies": {
    "@googlemaps/google-maps-services-js": "^3.3.26",
    "@grpc/grpc-js": "^1.8.2",
    "@headlessui/react": "^1.7.7",
    "@mapbox/rehype-prism": "^0.8.0",
    "@ory/kratos-client": "v0.10.1",
    "@protobuf-ts/grpc-transport": "^2.8.2",
    "@protobuf-ts/runtime": "^2.8.2",
    "@protobuf-ts/runtime-rpc": "^2.8.2",
    "@redis/client": "^1.4.2",
    "@remix-run/node": "^1.11.1",
    "@remix-run/react": "^1.11.1",
    "@remix-run/serve": "^1.11.1",
    "clsx": "^1.2.1",
    "framer-motion": "^8.3.4",
    "libphonenumber-js": "^1.10.17",
    "luxon": "^2.5.2",
    "pusher-js": "^8.0.1",
    "qrcode": "^1.5.1",
    "react": "^18.2.0",
    "react-dom": "18.2.0",
    "rehype-slug": "^5.1.0",
    "routes-gen": "^0.6.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.29.2",
    "@remix-run/dev": "^1.11.1",
    "@remix-run/eslint-config": "^1.11.1",
    "@remix-run/testing": "^1.11.1",
    "@routes-gen/remix": "^0.3.5",
    "@storybook/addon-actions": "^7.0.0-beta.33",
    "@storybook/addon-docs": "^7.0.0-beta.33",
    "@storybook/addon-essentials": "^7.0.0-beta.33",
    "@storybook/addon-interactions": "^7.0.0-beta.33",
    "@storybook/addon-links": "^7.0.0-beta.33",
    "@storybook/builder-vite": "^7.0.0-beta.33",
    "@storybook/client-api": "^7.0.0-beta.33",
    "@storybook/jest": "^0.0.11-next.0",
    "@storybook/react": "^7.0.0-beta.33",
    "@storybook/react-vite": "^7.0.0-beta.33",
    "@storybook/test-runner": "^0.10.0-next.5",
    "@storybook/testing-library": "^0.0.14-next.1",
    "@tailwindcss/forms": "^0.5.3",
    "@tailwindcss/typography": "^0.5.8",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/eslint": "^8.4.10",
    "@types/luxon": "^2",
    "@types/node": "^16.18.2",
    "@types/qrcode": "^1",
    "@types/react": "18.0.26",
    "@types/react-dom": "^18.0.10",
    "@types/testing-library__jest-dom": "^5",
    "@types/uuid": "^9.0.0",
    "@vitejs/plugin-react": "^3.0.1",
    "autoprefixer": "latest",
    "chromatic": "^6.14.0",
    "eslint": "^8.31.0",
    "eslint-config-prettier": "^8.6.0",
    "eslint-plugin-storybook": "^0.6.10",
    "jsdom": "^21.0.0",
    "npm-run-all": "^4.1.5",
    "postcss": "latest",
    "prettier": "^2.8.2",
    "prettier-plugin-tailwindcss": "^0.2.1",
    "storybook": "^7.0.0-beta.33",
    "tailwindcss": "^3.2.4",
    "typescript": "4.9.4",
    "vite": "^4.0.4",
    "vite-tsconfig-paths": "^4.0.3",
    "vitest": "^0.27.1"
  },
  "packageManager": "yarn@3.1.1",
  "engines": {
    "node": ">=14"
  },
  "sideEffects": false,
  "_id": "protea@0.1.0"
}
