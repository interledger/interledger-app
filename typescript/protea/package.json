{
  "name": "protea",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--inspect' remix dev",
    "build": "yarn typecheck && yarn build:css && remix build",
    "start": "remix-serve build",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "routes-gen": "routes-gen -d @routes-gen/remix",
    "generate": "graphql-codegen --config codegen.yml",
    "generate:watch": "graphql-codegen --watch --config codegen.yml",
    "build:css": "tailwindcss -m -i ./styles/app.css -o app/styles/app.css",
    "dev:css": "tailwindcss -w -i ./styles/app.css -o app/styles/app.css",
    "precommit": "yarn format && yarn lint && yarn routes-gen && yarn generate && yarn build",
    "test": "playwright test",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "@apollo/client": "^3.4.17",
    "@googlemaps/google-maps-services-js": "^3.3.16",
    "@grpc/grpc-js": "^1.6.7",
    "@headlessui/react": "^1.6.6",
    "@mapbox/rehype-prism": "^0.7.0",
    "@mxenabled/web-widget-sdk": "^0.0.8",
    "@ory/kratos-client": "0.8.2-alpha.1",
    "@protobuf-ts/grpc-transport": "^2.6.0",
    "@protobuf-ts/runtime": "^2.6.0",
    "@protobuf-ts/runtime-rpc": "^2.6.0",
    "@remix-run/node": "^1.6.5",
    "@remix-run/react": "^1.6.5",
    "@remix-run/serve": "^1.6.5",
    "graphql": "^16.0.1",
    "libphonenumber-js": "^1.10.7",
    "luxon": "^2.0.2",
    "react": "^17.0.2",
    "react-dom": "17.0.2",
    "rehype-slug": "^4.0.1",
    "routes-gen": "^0.5.1",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "2.2.2",
    "@graphql-codegen/typescript": "2.3.1",
    "@graphql-codegen/typescript-operations": "2.2.0",
    "@graphql-codegen/typescript-react-apollo": "^3.2.1",
    "@playwright/test": "^1.23.3",
    "@remix-run/dev": "^1.6.5",
    "@remix-run/eslint-config": "^1.6.5",
    "@routes-gen/remix": "^0.3.0",
    "@tailwindcss/forms": "^0.5.2",
    "@tailwindcss/typography": "^0.5.4",
    "@types/eslint": "^8.4.5",
    "@types/luxon": "^2",
    "@types/node": "^16.9.0",
    "@types/react": "17.0.24",
    "@types/react-dom": "^17.0.11",
    "@types/uuid": "^8.3.4",
    "autoprefixer": "latest",
    "eslint": "^8.20.0",
    "eslint-config-prettier": "^8.5.0",
    "postcss": "latest",
    "prettier": "^2.7.1",
    "prettier-plugin-tailwindcss": "^0.1.13",
    "tailwindcss": "^3.1.6",
    "typescript": "4.7.4"
  },
  "packageManager": "yarn@3.1.1",
  "engines": {
    "node": ">=14"
  },
  "sideEffects": false
}
