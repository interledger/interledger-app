{
  "name": "protea",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--inspect' remix dev",
    "build": "yarn typecheck && yarn build:css && remix build",
    "start": "remix-serve build",
    "lint": "eslint --fix --cache --cache-location ./node_modules/.cache/eslint .",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "routes-gen": "routes-gen -d @routes-gen/remix",
    "build:css": "tailwindcss -m -i ./styles/app.css -o app/styles/app.css",
    "dev:css": "tailwindcss -w -i ./styles/app.css -o app/styles/app.css",
    "precommit": "yarn format && yarn lint && yarn routes-gen && yarn build",
    "test": "playwright test",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "@googlemaps/google-maps-services-js": "^3.3.26",
    "@grpc/grpc-js": "^1.8.2",
    "@headlessui/react": "^1.7.7",
    "@mapbox/rehype-prism": "^0.8.0",
    "@ory/kratos-client": "v0.10.1",
    "@protobuf-ts/grpc-transport": "^2.8.2",
    "@protobuf-ts/runtime": "^2.8.2",
    "@protobuf-ts/runtime-rpc": "^2.8.2",
    "@redis/client": "^1.4.2",
    "@remix-run/node": "^1.10.0",
    "@remix-run/react": "^1.10.0",
    "@remix-run/serve": "^1.10.0",
    "clsx": "^1.2.1",
    "framer-motion": "^8.3.4",
    "libphonenumber-js": "^1.10.17",
    "luxon": "^2.5.2",
    "pusher-js": "^8.0.1",
    "qrcode": "^1.5.1",
    "react": "^18.2.0",
    "react-dom": "18.2.0",
    "rehype-slug": "^5.1.0",
    "routes-gen": "^0.6.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.29.2",
    "@remix-run/dev": "^1.10.0",
    "@remix-run/eslint-config": "^1.10.0",
    "@routes-gen/remix": "^0.3.5",
    "@tailwindcss/forms": "^0.5.3",
    "@tailwindcss/typography": "^0.5.8",
    "@types/eslint": "^8.4.10",
    "@types/luxon": "^2",
    "@types/node": "^16.18.2",
    "@types/qrcode": "^1",
    "@types/react": "18.0.26",
    "@types/react-dom": "^18.0.10",
    "@types/uuid": "^9.0.0",
    "autoprefixer": "latest",
    "eslint": "^8.31.0",
    "eslint-config-prettier": "^8.6.0",
    "postcss": "latest",
    "prettier": "^2.8.2",
    "prettier-plugin-tailwindcss": "^0.2.1",
    "tailwindcss": "^3.2.4",
    "typescript": "4.9.4"
  },
  "packageManager": "yarn@3.1.1",
  "engines": {
    "node": ">=14"
  },
  "sideEffects": false
}
