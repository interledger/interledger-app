    "@headlessui/react": "^1.7.14",
    "@hookform/resolvers": "^5.2.2",
    "@ory/client": "^1.22.37",
    "@react-router/node": "^7.13.1",
    "@react-router/serve": "^7.13.1",
    "@redis/client": "^1.5.7",
    "@segment/analytics-next": "^1.54.0",
    "@sentry/react-router": "^9.3.0",
    "@types/node-rsa": "^1.1.4",
    "clsx": "^1.2.1",
    "datocms-structured-text-utils": "^2.0.4",
    "dompurify": "^3.2.4",
    "framer-motion": "^10.16.4",
    "isbot": "^3.6.10",
    "libphonenumber-js": "^1.10.30",
    "luxon": "^3.3.0",
    "node-rsa": "^1.1.1",
    "pino": "^8.17.2",
    "pino-http": "^8.6.1",
    "pusher-js": "^8.3.0",
    "qrcode": "^1.5.3",
    "react": "^18.2.0",
    "react-datocms": "^4.0.15",
    "react-dom": "18.2.0",
    "react-hook-form": "^7.62.0",
    "react-router": "^7.13.1",
    "shiki": "^0.14.3",
    "uuid": "^14.0.0",
    "zod": "^4.0.14",
    "zustand": "^4.3.9"
