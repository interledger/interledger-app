{
  "name": "protea",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "react-router typegen && pnpm typecheck && react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "lint": "eslint --fix --cache --cache-location ./node_modules/.cache/eslint .",
    "lint:check": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "precommit": "pnpm format && pnpm lint && pnpm build",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "test:unit": "vitest",
    "chromatic": "chromatic --exit-zero-on-changes",
    "upload-sourcemaps": "sentry-upload-sourcemaps --release $IMAGE_HASH && sentry-upload-sourcemaps --release $IMAGE_HASH --url-prefix /app/build --buildPath build "
  },
  "dependencies": {
    "@bufbuild/connect": "^0.12.0",
    "@bufbuild/connect-node": "^0.12.0",
    "@bufbuild/protobuf": "^1.3.0",
