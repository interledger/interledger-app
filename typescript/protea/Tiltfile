sync_app = sync('./app', '/app/app')
sync_public = sync('./public', '/app/public')
sync_generated = sync('./generated', '/app/generated')

local_resource('generate watch', serve_cmd = 'yarn generate:watch')
local_resource('tailwind watch', cmd = 'yarn build:css', deps=['./app'], ignore=['./app/styles'])
local_resource('protea port forward', serve_cmd = 'kubectl port-forward deployment/protea 8002:8002', resource_deps = ['protea'])
local_resource('protea port forward debugging', serve_cmd = 'kubectl port-forward deployment/protea 9229:9229', resource_deps = ['protea'])
local_resource('mailhog port forward', serve_cmd = 'kubectl port-forward deployment/mailhog 8025:8025', resource_deps = ['protea'], links=['http://fynbos.test:8025'])

docker_build('protea', '.', target = "dev", live_update = [
  sync_app, sync_public, sync_generated
], ignore = ["deploy/"])

k8s_custom_deploy(
  "protea",
  apply_cmd="""
      kubectl -v=0 set image deployment/protea protea=$TILT_IMAGE_0 > /dev/null && \
      kubectl get deployment/protea -o yaml
  """,
  delete_cmd = "echo protea managed outside of Tilt",
  image_deps = ["protea"],
  deps = [],
)
