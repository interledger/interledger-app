{
  "name": "botanist",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--inspect' remix dev",
    "build": "pnpm typecheck && remix build",
    "start": "remix-serve build",
    "lint": "eslint --fix --cache --cache-location ./node_modules/.cache/eslint .",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "routes-gen": "routes-gen -d @routes-gen/remix",
    "build:css": "tailwindcss -m -i ./styles/app.css -o app/styles/app.css",
    "dev:css": "tailwindcss -w -i ./styles/app.css -o app/styles/app.css",
    "precommit": "pnpm format && pnpm lint && pnpm routes-gen && pnpm build",
    "test": "playwright test",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.8.14",
    "@headlessui/react": "^1.7.14",
    "@protobuf-ts/grpc-transport": "^2.9.0",
    "@protobuf-ts/runtime": "^2.9.0",
    "@protobuf-ts/runtime-rpc": "^2.9.0",
    "@remix-run/node": "^1.16.0",
    "@remix-run/react": "^1.16.0",
    "@remix-run/serve": "^1.16.0",
    "clsx": "^1.2.1",
    "isbot": "^3.6.10",
    "luxon": "^3.3.0",
    "react": "^18.2.0",
    "react-dom": "18.2.0",
    "routes-gen": "^0.6.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@remix-run/dev": "^1.16.0",
    "@remix-run/eslint-config": "^1.16.0",
    "@routes-gen/remix": "^0.3.6",
    "@tailwindcss/forms": "^0.5.3",
    "@tailwindcss/typography": "^0.5.19",
    "@types/eslint": "^8.37.0",
    "@types/luxon": "^3.3.0",
    "@types/node": "^20.1.2",
    "@types/react": "18.2.6",
    "@types/react-dom": "^18.2.4",
    "@types/uuid": "^9.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^8.40.0",
    "eslint-config-prettier": "^8.8.0",
    "prettier": "^2.8.8",
    "prettier-plugin-tailwindcss": "^0.2.8",
    "tailwindcss": "^3.3.2",
    "typescript": "5.0.4"
  },
  "packageManager": "pnpm@8.5.0",
  "engines": {
    "node": ">=14"
  },
  "sideEffects": false
}
