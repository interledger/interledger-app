{
  "name": "botanist",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--inspect' remix dev",
    "build": "pnpm typecheck && pnpm build:css && remix build",
    "start": "remix-serve build",
    "lint": "eslint --fix --cache --cache-location ./node_modules/.cache/eslint .",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "routes-gen": "routes-gen -d @routes-gen/remix",
    "build:css": "tailwindcss -m -i ./styles/app.css -o app/styles/app.css",
    "dev:css": "tailwindcss -w -i ./styles/app.css -o app/styles/app.css",
    "precommit": "pnpm format && pnpm lint && pnpm routes-gen && pnpm build",
    "test": "playwright test",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.8.7",
    "@headlessui/react": "^1.7.7",
    "@protobuf-ts/grpc-transport": "^2.8.2",
    "@protobuf-ts/runtime": "^2.8.2",
    "@protobuf-ts/runtime-rpc": "^2.8.2",
    "@remix-run/node": "^1.11.1",
    "@remix-run/react": "^1.11.1",
    "@remix-run/serve": "^1.11.1",
    "clsx": "^1.2.1",
    "luxon": "^2.5.2",
    "react": "^17.0.2",
    "react-dom": "17.0.2",
    "routes-gen": "^0.5.2",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@remix-run/dev": "^1.11.1",
    "@remix-run/eslint-config": "^1.11.1",
    "@routes-gen/remix": "^0.3.5",
    "@tailwindcss/forms": "^0.5.3",
    "@tailwindcss/typography": "^0.5.9",
    "@types/eslint": "^8.4.10",
    "@types/keyv": "^3.1.4",
    "@types/luxon": "^2.4.0",
    "@types/node": "^16.18.11",
    "@types/react": "17.0.24",
    "@types/react-dom": "^17.0.18",
    "@types/uuid": "^8.3.4",
    "autoprefixer": "^10.4.13",
    "eslint": "^8.32.0",
    "eslint-config-prettier": "^8.6.0",
    "postcss": "^8.4.21",
    "prettier": "^2.8.3",
    "prettier-plugin-tailwindcss": "^0.1.13",
    "tailwindcss": "^3.2.4",
    "typescript": "4.7.4"
  },
  "engines": {
    "node": ">=14"
  },
  "sideEffects": false
}
