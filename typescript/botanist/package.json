{
  "name": "botanist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "pnpm typecheck && react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "lint": "eslint --fix --cache --cache-location ./node_modules/.cache/eslint .",
    "lint:check": "eslint --max-warnings=0 --cache --cache-location ./node_modules/.cache/eslint .",
    "typecheck": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "precommit": "pnpm format && pnpm lint && pnpm build",
    "test": "playwright test",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.8.14",
    "@headlessui/react": "^1.7.14",
    "@protobuf-ts/grpc-transport": "^2.9.0",
    "@protobuf-ts/runtime": "^2.9.0",
    "@protobuf-ts/runtime-rpc": "^2.9.0",
    "@react-router/node": "^7.13.1",
    "@react-router/serve": "^7.13.1",
    "clsx": "^1.2.1",
    "isbot": "^4.4.0",
    "luxon": "^3.3.0",
    "react": "^18.2.0",
    "react-dom": "18.2.0",
    "react-router": "^7.13.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@react-router/dev": "^7.13.1",
    "@react-router/fs-routes": "^7.13.1",
    "@tailwindcss/forms": "^0.5.3",
    "@tailwindcss/typography": "^0.5.19",
    "@types/eslint": "^8.37.0",
    "@types/luxon": "^3.3.0",
    "@types/node": "^20.1.2",
    "@types/react": "18.2.6",
    "@types/react-dom": "^18.2.4",
    "@types/uuid": "^9.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^8.40.0",
    "eslint-config-prettier": "^8.8.0",
    "postcss": "^8.4.23",
    "prettier": "^2.8.8",
    "prettier-plugin-tailwindcss": "^0.2.8",
    "tailwindcss": "^3.3.2",
    "typescript": "^5.2.2",
    "vite": "^6.0.0",
    "vite-tsconfig-paths": "^4.2.0"
  },
  "packageManager": "pnpm@8.5.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "sideEffects": false
}
