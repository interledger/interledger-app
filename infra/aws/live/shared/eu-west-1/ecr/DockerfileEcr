FROM ubuntu:20.04

# Update to local SA mirror for building
RUN sed -E -i 's#http://[^\s]*archive\.ubuntu\.com/ubuntu#http://ftp.leg.uct.ac.za/ubuntu#g' /etc/apt/sources.list
RUN apt-get update && apt-get install -y curl gcc

# Install docker v19.03.15 which is required for our GL Runner
RUN (curl -sSL https://releases.rancher.com/install-docker/19.03.15.sh | sh)

# Install golang
RUN curl -OL https://golang.org/dl/go1.17.6.linux-amd64.tar.gz
RUN tar -C /usr/local -xvf go1.17.6.linux-amd64.tar.gz
RUN rm -f go1.17.6.linux-amd64.tar.gz
ENV PATH="$PATH:/usr/local/go/bin"