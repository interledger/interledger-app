FROM ubuntu:22.04

# Update to local SA mirror for building
# RUN sed -E -i 's#http://[^\s]*archive\.ubuntu\.com/ubuntu#http://ftp.leg.uct.ac.za/ubuntu#g' /etc/apt/sources.list
RUN apt-get update && apt-get install -y curl gcc make jq git

# Install docker v20.10 which is required for our GL Runner
RUN curl https://download.docker.com/linux/ubuntu/dists/impish/pool/stable/amd64/docker-ce-cli_20.10.12~3-0~ubuntu-impish_amd64.deb -o docker.deb \
    && dpkg -i docker.deb \
    && rm -f docker.deb

# Install docker compose plugin
RUN DOCKER_CONFIG=${DOCKER_CONFIG:-$HOME/.docker} \
    && mkdir -p $DOCKER_CONFIG/cli-plugins \
    && curl -SL https://github.com/docker/compose/releases/download/v2.5.0/docker-compose-linux-x86_64 -o $DOCKER_CONFIG/cli-plugins/docker-compose \
    && chmod +x $DOCKER_CONFIG/cli-plugins/docker-compose 

# Install golang
RUN curl -OL https://golang.org/dl/go1.18.linux-amd64.tar.gz
RUN tar -C /usr/local -xvf go1.18.linux-amd64.tar.gz
RUN rm -f go1.17.6.linux-amd64.tar.gz
ENV PATH="$PATH:/usr/local/go/bin"

# Install golangci-lint
RUN curl -sSfL https://raw.githubusercontent.com/golangci/golangci-lint/master/install.sh | sh -s v1.45.2

# Install ECR Login
RUN go install github.com/awslabs/amazon-ecr-credential-helper/ecr-login/cli/docker-credential-ecr-login@latest
RUN mv ~/go/bin/docker-credential-ecr-login /usr/local/bin
RUN go clean -modcache
