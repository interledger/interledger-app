[req]
default_bits        = 2048
prompt              = no
default_md          = sha256
req_extensions      = req_ext
distinguished_name  = dn

[dn]
CN = interledger.kind
O  = Interledger Foundation
C  = US

[req_ext]
subjectAltName = @alt_names

[v3_ca]
subjectAltName = @alt_names

[alt_names]
DNS.1 = interledger.kind
DNS.2 = *.interledger.kind
