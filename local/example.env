# Example overrides for local compose services
# Copy to .env and adjust values as needed.
#
# Secrets shown as <...> are PLACEHOLDERS, not real values. They are NOT needed for
# normal local development - telemetry/SMS/push degrade gracefully and providers use
# the local mock* services. For real/deployed values, get them from the team secret
# manager (1Password); ask the team if unsure.
#
# NOTE: The backend's application config lives in config/backend.yaml - NOT here.
# To override a backend setting locally, edit config-override/backend.yaml (created
# empty by `make prep`). The only BACKEND_* variables still read from the environment
# are the few shared with the rafiki and redis compose services, listed at the bottom.

# ----------------------------
# Protea service overrides
# ----------------------------
# Dockerfile stage to build/run for local compose (dev | runner)
BOTANIST_BUILD_TARGET=dev
PROTEA_ILW_ENV=local
PROTEA_LOG_LEVEL=debug
PROTEA_LOG_PRETTY=true
PROTEA_KRATOS_URL=http://kratos:4433
PROTEA_RAFIKI_AUTH_ENDPOINT=http://rafiki_auth:3009
PROTEA_RAFIKI_AUTH_SECRET=my-super-secret-identity-key
PROTEA_CHOKIDAR_USEPOLLING=true
PROTEA_COOKIE_SECRETS=["localsecret"]
# optional: set to enable Pusher realtime updates locally; leave empty to disable.
PROTEA_PUSHER_APP_KEY=
PROTEA_PUSHER_APP_CLUSTER=eu
PROTEA_PAYMENT_POINTER_BASE=local.ilp.link
PROTEA_BACKEND_GRPC_URL=http://backend:8443
PROTEA_REDIS_URL=redis://redis:6379/2
PROTEA_PERSONA_SDK_URL=https://mockxago.interledger.test/v1/persona-sdk.js # Production https://cdn.withpersona.com/dist/persona-v4.8.0-alpha.js
PROTEA_TARGET_HOST=https://interledger.test
# Sentry is disabled locally by default (no DSN). Set PROTEA_SENTRY_DSN to enable.
# PROTEA_SENTRY_DSN=
# PROTEA_SENTRY_ENV_LABEL=local

# ----------------------------
# Shared backend / rafiki overrides
# ----------------------------
# These are consumed by the rafiki compose service and all have working defaults
# (shown after :- in the compose files). Uncomment only to override.
# BACKEND_ADMIN_API_SECRET=test-admin-api-key
# BACKEND_OPERATOR_TENANT_ID=6b1f9f73-3d4b-4f52-9f2a-9f6a8d0a7c5e
# BACKEND_SIGNATURE_VERSION=1
