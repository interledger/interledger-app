# Example overrides for local compose services
# Copy to .env and adjust values as needed.

# ----------------------------
# Protea service overrides
# ----------------------------
# Dockerfile stage to build/run for local compose (dev | runner)
PROTEA_BUILD_TARGET=dev
# Dockerfile stage to build/run for local compose (dev | runner)
BOTANIST_BUILD_TARGET=dev
PROTEA_FYNBOS_ENV=local
PROTEA_LOG_LEVEL=debug
PROTEA_LOG_PRETTY=true
PROTEA_KRATOS_URL=http://kratos:4433
PROTEA_RAFIKI_AUTH_ENDPOINT=http://rafiki_auth:3009
PROTEA_RAFIKI_AUTH_SECRET=my-super-secret-identity-key
PROTEA_CHOKIDAR_USEPOLLING=true
PROTEA_COOKIE_SECRETS=["localsecret"]
PROTEA_PUSHER_APP_KEY=91988d6075551d29760a
PROTEA_PUSHER_APP_CLUSTER=eu
PROTEA_PAYMENT_POINTER_BASE=local.ilp.link
PROTEA_DATO_API_TOKEN=b96709bce873f5280722da965b0e9d
PROTEA_BACKEND_GRPC_URL=http://backend:8443
PROTEA_REDIS_URL=redis://redis:6379/2
PROTEA_REMIX_PUBLIC_PATH=
PROTEA_PERSONA_SDK_URL=https://mockxago.interledger.test/v1/persona-sdk.js # Production https://cdn.withpersona.com/dist/persona-v4.8.0-alpha.js
PROTEA_TARGET_HOST=https://interledger.test
# Sentry is disabled locally by default (no DSN). Set PROTEA_SENTRY_DSN to enable.
# PROTEA_SENTRY_DSN=
# PROTEA_SENTRY_ENV_LABEL=local

